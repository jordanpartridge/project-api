parameters:
    level: 8
    paths:
        - app
        - tests
    
    # Exclude files or directories from analysis
    excludePaths:
        - */vendor/*
        
    # Specific checks and rules
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false

    # Ignore certain errors
    ignoreErrors:
        - '#Call to an undefined method#'
        - '#Access to an undefined property#'
        
    # Symfony DI container integration
    symfony:
        container_xml_path: var/cache/dev/App_KernelDevDebugContainer.xml

    # Custom rules
    rules:
        - PHPStan\Rules\Deprecations\CallToDeprecatedMethodRule
        - PHPStan\Rules\Deprecations\CallToDeprecatedStaticMethodRule
